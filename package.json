{
  "name": "secondbrainsystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "db:env": "tsx scripts/db.ts env",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:verify": "node --env-file=.env.local --import tsx scripts/db-verify.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
