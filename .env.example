# Copy to .env.local for local development. Local development must use the STAGING project.
# Only the publishable (anon) key belongs here — never a secret or service-role key.
NEXT_PUBLIC_AAA_DATA_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>

# Optional: copy the block below to .env.staging.local for `npm run staging:verify`.
# Create these two users in the STAGING project only (Authentication → Users → Add user, auto-confirm).
# STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>
# STAGING_TEST_USER_A_EMAIL=
# STAGING_TEST_USER_A_PASSWORD=
# STAGING_TEST_USER_B_EMAIL=
# STAGING_TEST_USER_B_PASSWORD=
