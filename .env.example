# Local development settings. Easiest: run `npm run db:start` then `npm run db:env`, which writes
# these three values into .env.local for you. Local development can never use the production project.
# Only the publishable (anon) key belongs here — never a secret or service-role key.
NEXT_PUBLIC_AAA_DATA_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<printed by `npx supabase status`>
